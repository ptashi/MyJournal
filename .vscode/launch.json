{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:3000/api",
        "CUSTOM_SECRET_KEY": "my-secret-value"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "- Local:\\s+(https?://localhost:\\d+)",
        "uriFormat": "%s"
      }
    }
  ]
}
